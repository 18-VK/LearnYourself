<Window
        x:Class="TaskFlowStudio.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TaskFlowStudio.View.Main"
        MinHeight="450"
        MinWidth="800"
        Title="Taskflow studio"
        Icon="/Resources/Icons/TaskflowStudioIcon.ico">
    <DockPanel>
        <!-- Header -->
        <Grid DockPanel.Dock="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>
            <ContentControl Content="{StaticResource TaskflowLogo}"
                            Grid.Row="0"
                            Height="40"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"/>
            
            <Border Grid.Row="1" Height="1"
                     Background="#D1D5DB"
                     HorizontalAlignment="Stretch"/>
        </Grid>
        <Grid>
            
            <Grid.RowDefinitions>
                <RowDefinition Height="*"> </RowDefinition>
            </Grid.RowDefinitions>
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="25*"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="75*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <!--left- toolbar having projects list-->
            <!--<local:LeftToolbar Grid.Column="0"/>-->

            <ContentControl Grid.Column="0" Content="{Binding LeftToolbarVM}"></ContentControl>
            
            <Border Grid.Column="1" Width="1"
                    Background="#D1D5DB"
                    VerticalAlignment="Stretch"/>

            <!--left- RightTaskList having task list-->
            <!--<local:RightTaskList Grid.Column="2"/>-->

            <ContentControl Grid.Column="2" Content="{Binding RightTaskListVM}"></ContentControl>
        </Grid>
    </DockPanel>
</Window>
