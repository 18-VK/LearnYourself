{
  "name": "learnyourself-site",
  "version": "0.1.0",
  "private": true,
  "description": "LearnYourself: an interactive learning site generated from the .NET study notes in this repository.",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "content": "tsx scripts/build-content.ts",
    "content:dry": "tsx scripts/build-content.ts --dry",
    "data:check": "tsx scripts/check-data.ts",
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist && tsx scripts/verify-output.ts",
    "preview": "astro preview",
    "playground": "vite --config playground/vite.config.ts",
    "check": "astro check && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "tsx scripts/verify-output.ts",
    "runner": "tsx scripts/runner/step.ts",
    "runner:check": "tsx scripts/runner/check.ts",
    "test:runner": "cd runner && dotnet test --project Runner.Tests/Runner.Tests.csproj -c Release",
    "scan:personal": "tsx scripts/scan-personal.ts"
  },
  "dependencies": {
    "@astrojs/react": "7.0.1",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/literata": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "astro": "7.3.8",
    "d3-hierarchy": "3.1.2",
    "d3-scale": "4.0.2",
    "motion": "14.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.3.2",
    "@playwright/test": "1.64.0",
    "@shikijs/transformers": "4.5.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/d3-hierarchy": "3.1.7",
    "@types/d3-scale": "4.0.9",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/unist": "3.0.3",
    "github-slugger": "2.0.0",
    "hast-util-from-html": "2.0.3",
    "hast-util-select": "6.0.4",
    "hast-util-to-string": "3.0.1",
    "mammoth": "1.13.0",
    "mdast-util-to-string": "4.0.0",
    "pagefind": "1.5.2",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vitest": "5.0.4",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
