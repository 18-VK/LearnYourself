<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="RoundCheckBoxStyle"
       TargetType="CheckBox">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="16" Height="16">

                        <!-- Outer circle -->
                        <Ellipse x:Name="Outer"
                             Width="16"
                             Height="16"
                             Stroke="#9E9E9E"
                             StrokeThickness="1"
                             Fill="Transparent"
                             Visibility="Visible"/>

                        <!-- Inner filled circle -->
                        <Ellipse x:Name="Inner"
                             Width="12"
                             Height="12"
                             Fill="#4F6BED"
                             Visibility="Collapsed"/>

                        <!-- Tick mark -->
                        <Viewbox Width="10"
                                 Height="10"
                                 
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                            <Path x:Name="Tick"
                                  Visibility="Collapsed"
                                  Data="M 1 5 L 4 8 L 9 2"
                                  Stroke="White"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                        </Viewbox>

                    </Grid>

                    <ControlTemplate.Triggers>

                        <!-- Checked -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Outer"
                                Property="Visibility"
                                Value="Collapsed"/>
                            <Setter TargetName="Inner"
                                Property="Visibility"
                                Value="Visible"/>
                            
                            <Setter TargetName="Inner"
                                Property="Height"
                                Value="16"
                                />

                            <Setter TargetName="Inner"
                                Property="Width"
                                Value="16"
                                />
                            <Setter TargetName="Tick"
                                Property="Visibility"
                                Value="Visible"/>
                        </Trigger>

                        <!-- Hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Outer"
                                Property="Stroke"
                                Value="#4F6BED"
                                />
                            <Setter TargetName="Tick"
                                Property="Visibility"
                                Value="Visible"/>
                            <Setter TargetName="Tick"
                                    Property="Stroke"
                                    Value="#4F6BED"
                                    />
                        </Trigger>

                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Outer"
                                Property="Opacity"
                                Value="0.4"/>
                            <Setter TargetName="Inner"
                                Property="Opacity"
                                Value="0.4"/>
                            <Setter TargetName="Tick"
                                Property="Opacity"
                                Value="0.4"/>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>