<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Viewbox x:Key="TaskflowLogo" Stretch="Uniform">
        <Grid Width="420" Height="80">

            <!-- Gradient -->
            <Grid.Resources>
                <LinearGradientBrush x:Key="LogoGradient"
                                     StartPoint="0,0"
                                     EndPoint="1,1">
                    <GradientStop Color="#6A1B9A" Offset="0"/>
                    <GradientStop Color="#D81B60" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Resources>

            <!-- Box -->
            <Border Width="50"
                    Height="50"
                    CornerRadius="6"
                    BorderThickness="4"
                    BorderBrush="{StaticResource LogoGradient}"
                    Margin="-350,0,0,0"/>

            <!-- Check -->
            <Path Data="M22,36 L32,46 L48,24"
                  Stroke="{StaticResource LogoGradient}"
                  StrokeThickness="5"
                  StrokeLineJoin="Round"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"/>


            <!-- Motion lines -->
            <Rectangle Fill="#D81B60" Width="20" Height="4"
                       RadiusX="2" RadiusY="2"
                       Margin="-280,22,0,0"
                       VerticalAlignment="Top"/>
            <Rectangle Fill="#D81B60" Width="26" Height="4"
                       RadiusX="2" RadiusY="2"
                       Margin="-280,32,0,0"
                       VerticalAlignment="Top"/>
            <Rectangle Fill="#D81B60" Width="20" Height="4"
                       RadiusX="2" RadiusY="2"
                       Margin="-280,42,0,0"
                       VerticalAlignment="Top"/>

            <!-- Text -->
            <TextBlock Margin="100,0,0,0"
                       VerticalAlignment="Center"
                       FontFamily="Segoe UI"
                       FontSize="32"
                       Foreground="{DynamicResource LogoTextBrush}">
                Taskflow studio
                <!--<Run FontSize="26"
                     Foreground="{DynamicResource LogoSubTextBrush}">
                    studio
                </Run>-->
            </TextBlock>

        </Grid>
    </Viewbox>

</ResourceDictionary>
