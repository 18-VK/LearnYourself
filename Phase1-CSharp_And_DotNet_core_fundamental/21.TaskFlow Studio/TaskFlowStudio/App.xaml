<Application x:Class="TaskFlowStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TaskFlowStudio"
             ShutdownMode="OnExplicitShutdown"
             xmlns:views="clr-namespace:TaskFlowStudio.View.Main"
             xmlns:vm="clr-namespace:TaskFlowStudio.ViewModel.Main">
    
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="Resources/Colors.xaml"/>-->
                <ResourceDictionary Source="/Resources/Themes/Dark.xaml"/>
                <ResourceDictionary Source="/Resources/Themes/Light.xaml"/>
                <ResourceDictionary Source="/Resources/Logos/Taskflowstudiologo.xaml"/>
                <ResourceDictionary Source="/Resources/Logos/Taskflowstudiologo.xaml"/>
                <ResourceDictionary Source="/Resources/Styles/Button.xaml"/>
                <ResourceDictionary Source="/Resources/Styles/ListBoxStyle.xaml"/>
                <ResourceDictionary Source="/Resources/Converters/Converter.xaml"/>
                <ResourceDictionary Source="/Resources/Styles/RoundCheckBox.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:MainRightTaskListViewModel}">
                <views:RightTaskList/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MainLeftToolbarViewModel}">
                <views:LeftToolbar/>
            </DataTemplate>
        </ResourceDictionary>
        
    </Application.Resources>
</Application>
