<UserControl x:Class="TaskFlowStudio.View.Main.LeftToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TaskFlowStudio.View.Main"
             xmlns:local1="clr-namespace:TaskFlowStudio.Resources.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="800"
             Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="5*"></RowDefinition>
            <RowDefinition Height="4*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <!--file menu bar-->
        <Border Grid.Row="0"
                Padding="0,0,0,4">
            <Menu Background="{Binding Background,
                RelativeSource={RelativeSource AncestorType=UserControl}}"
                FontSize="14">
                <MenuItem Header="_File">
                    <MenuItem Command ="{Binding ImportFile}" Header="Import"/>
                    <MenuItem Command ="{Binding ExportFile}" Header="export"/>
                </MenuItem>
                <MenuItem Header="_Options">
                    <MenuItem Command="{Binding cmdLiveMonitor}" Header="Live Monitor Window"/>
                    <MenuItem Command="{Binding cmdSetting}" Header="Setting Window"/>
                </MenuItem>
            </Menu>
        </Border>
        <!--search bar-->
        <local1:TextSearchbar Grid.Row="1" Margin="8,0,8,0" 
                              Padding="0,0,0,4"
                              Text="{Binding SearchText}"
                              Placeholder ="Search here.."/>
        <!--Active projects-->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER using grid share size group to line header center with completed projects-->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8*" SharedSizeGroup="HeaderCenter"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Viewbox Grid.Column="1" Stretch="Uniform"
                         HorizontalAlignment="Left"
                         MaxHeight="25">
                    <TextBlock Text="Active Projects" Margin="0,2"/>
                </Viewbox>
            </Grid>

            <!-- SEPARATOR -->
            <Border Grid.Row="1"
                    Height="1"
                    Background="#D1D5DB"
                    Opacity="0.4"/>

            <!-- LIST -->
            <local1:ChecklistControl Grid.Row="2"
                 ItemsSource="{Binding ActiveProjects}"/>
            
        </Grid>

        <!--Completed projects-->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8*" SharedSizeGroup="HeaderCenter"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Viewbox Grid.Column="1" Stretch="Uniform"
                           HorizontalAlignment="Left"
                           MaxHeight="25">      
                    <TextBlock Text="Completed Projects" Margin="0,2"/>
                </Viewbox>
            </Grid>

            <!-- SEPARATOR -->
            <Border Grid.Row="1"
                Height="1"
                Background="#D1D5DB"
                Opacity="0.4"/>

            <!-- LIST -->
            <local1:ChecklistControl Grid.Row="2"
                    ItemsSource="{Binding CompletedProjects}"/>
        </Grid>

        <!--Add Projects-->
        <Button Grid.Row="4" 
                Command="{Binding AddProject}"
                Style="{StaticResource TwoColumnButtonStyle}"
                Tag="+"
                Content="Add Projects"
                Margin="8,2,8,4">
        </Button>

    </Grid>

</UserControl>
