<UserControl x:Class="TaskFlowStudio.Resources.Controls.DropDownListWithLable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TaskFlowStudio.Resources.Controls"
             mc:Ignorable="d" 
             x:Name="root"
             d:DesignHeight="50" d:DesignWidth="800">

    <Grid>

        <!-- MAIN CLICKABLE AREA -->
        <Border x:Name="MainBorder"
                CornerRadius="6"
                BorderBrush="#D1D1D1"
                BorderThickness="0"
                Background="White"
                Cursor="Hand"
                Padding="8,4,8,4"
                MouseLeftButtonUp="MainBorder_Click">

            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F5F6F8"/>
                            <Setter Property="BorderBrush" Value="#C8C8C8"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LABEL -->
                <TextBlock Text="{Binding Label, ElementName=root}"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Margin="0,0,8,0"/>

                <!-- SELECTED VALUE -->
                <TextBlock Grid.Column="1"
                           Text="{Binding SelectedValue, ElementName=root}"
                           VerticalAlignment="Center"
                           FontSize="14"/>
            </Grid>
        </Border>

        <!-- DROPDOWN POPUP -->
        <Popup x:Name="DropdownPopup"
               PlacementTarget="{Binding ElementName=MainBorder}"
               Placement="Bottom"
               StaysOpen="False">

            <StackPanel Background="White">

                <!-- Clear filter -->
                <Button Content="Clear filter"
                    HorizontalAlignment="Right"
                    FontSize="14"
                    Background="Transparent"
                    BorderBrush="#D1D1D1"
                    BorderThickness="0"
                    Click="ClearFilter_Click"/>
                
                <Border Background="White"
                        BorderBrush="#D1D1D1"
                        BorderThickness="1"
                        Width="{Binding ActualWidth, ElementName=MainBorder}">


                    <ListBox  ItemsSource="{Binding ItemsSource, ElementName=root}"
                            DisplayMemberPath="{Binding DisplayMemberPath, ElementName=root}"
                            ItemTemplate="{Binding ItemTemplate, ElementName=root}"
                            SelectedItem="{Binding SelectedItem, ElementName=root, Mode=TwoWay}"
                            SelectedValuePath="{Binding SelectedValuePath, ElementName=root}"
                            SelectedValue="{Binding SelectedValue, ElementName=root, Mode=TwoWay}"
                            SelectionChanged="ListBox_SelectionChanged"
                            BorderThickness="0"
                            FontSize="14"/>
                </Border>
            </StackPanel>
        </Popup>

    </Grid>
</UserControl>
