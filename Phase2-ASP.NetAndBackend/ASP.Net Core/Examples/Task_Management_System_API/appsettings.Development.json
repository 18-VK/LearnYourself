{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=DevelopmentTesting;Trusted_Connection=True;Encrypt=False;"
  },
  "jwt": {
    "Issuer": "TASK_MANAGEMENT_AUTHSERVER",
    "Audience": "TASK_MANAGEMENT_API",
    "AccessTokenExpiryMinutes": 12,
    "RefreshTokenExpiryDays": 14,
    "PrivateKeyPath": "C:\\Users\\amanp\\Downloads\\JWT_Practice\\JWTPractice\\bin\\Debug\\net8.0\\private_key.pem",
    "PublicKeyPath": "C:\\Users\\amanp\\Downloads\\JWT_Practice\\JWTPractice\\bin\\Debug\\net8.0\\public_key.pem"
  },
  "AdminSettings": {
    "Email": "admin@example.com",
    "Username": "superadmin"
  },
  "DBConfig": {
    "maxRetryCount": 3,
    "maxRetryDelayInSec": 10
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Error",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        },
        "RestrictedToMinimumLevel": "Information",
        "Filter": [
          {
            "Name": "ByExcluding",
            "Args": {
              "expression": "Level == Error or Level == Fatal"
            }
          }
        ]
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/errlog-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        },
        "RestrictedToMinimumLevel": "Error"
      }
    ]
  },
  "AllowedHosts": "*"
}
