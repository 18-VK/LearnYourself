<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Shared by the browser runner (Runner.Wasm) and the build-time check (Runner.Check):
    how a note's block becomes a program, how it is compiled, and how it is run.
    Keeping one copy is what makes "runnable at build time" mean "runs in the browser".
  -->
  <PropertyGroup>
    <RootNamespace>LearnYourself.Runner</RootNamespace>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>
</Project>
